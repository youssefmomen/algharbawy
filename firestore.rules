rules_version = '2';
// قواعد Firestore — مؤسسة الغرباوي (المرحلة ٢: المعلمون والاختبارات والألعاب)
// الصق هذا المحتوى كاملًا في: Firebase Console ← Firestore Database ← Rules ← نشر (Publish)
//
// ملاحظة مهمة: بريد المدير لا يُكتب هنا حفاظًا على الخصوصية.
// المدير يُعرَّف عبر وثيقة config/admin في قاعدة البيانات تحوي الحقل email.
// (يُنشئها المالك مرة واحدة من لوحة Firebase — خطوة واحدة موضحة في التعليمات.)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // المدير: بريده مطابق للحقل email في وثيقة config/admin (المقارنة لا تتأثر بكِبَر/صِغَر الأحرف)، أو وثيقة admins/{uid}
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email.lower() == get(/databases/$(database)/documents/config/admin).data.email.lower()
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    // معلم مقبول
    function isTeacher() {
      return signedIn()
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.status == "approved";
    }

    // شريط الإعلانات: قراءة عامة للزوار، والكتابة للمدير فقط
    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // إعدادات داخلية: لا قراءة ولا كتابة من المتصفح (تُقرأ من القواعد فقط)
    match /config/{doc} {
      allow read, write: if false;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    match /users/{uid} {
      allow get, list: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // الملف الشخصي: email/lastActive تلقائيان، وname/role/avatarId/avatarData يضبطها المستخدم بنفسه
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'lastActive', 'name', 'role', 'avatarId', 'avatarData'])
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['student', 'teacher'])
        && (!request.resource.data.keys().hasAny(['name']) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (!request.resource.data.keys().hasAny(['avatarId']) || (request.resource.data.avatarId is string && request.resource.data.avatarId.size() <= 24))
        && (!request.resource.data.keys().hasAny(['avatarData']) || (request.resource.data.avatarData is string && request.resource.data.avatarData.size() <= 120000));
      allow delete: if false;
    }

    match /progress/{uid} {
      allow get, list: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['completed', 'xp', 'stars']);
      allow delete: if false;
    }

    // المعلمون: تسجيل ذاتي بحالة pending، والموافقة من المدير فقط
    match /teachers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly(['email', 'name', 'status', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // طلاب المعلم (قائمة تعيين الواجبات): يديرها المعلم صاحبها فقط
    match /teacherStudents/{id} {
      allow get, list: if (isTeacher() && resource.data.teacherId == request.auth.uid) || isAdmin();
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly(['teacherId', 'email', 'addedAt']);
      allow update: if false;
      allow delete: if (isTeacher() && resource.data.teacherId == request.auth.uid) || isAdmin();
    }

    // فتح الواجبات: الطالب يسجّل فتحه مرة واحدة، ويقرأه هو أو المعلم صاحب الواجب أو المدير
    match /hwActivity/{id} {
      allow get, list: if signedIn() && (
        resource.data.uid == request.auth.uid
        || resource.data.teacherId == request.auth.uid
        || isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'refId', 'teacherId', 'uid', 'email', 'openedAt']);
      allow update, delete: if false;
    }

    // الاختبارات والألعاب: الطلاب يقرأون المنشور، والمعلم المقبول يدير ما أنشأه
    match /paths/{id} {
      allow get: if signedIn() && (resource.data.published == true || resource.data.teacherId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.published == true || resource.data.teacherId == request.auth.uid || isAdmin());
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if (isTeacher() && resource.data.teacherId == request.auth.uid) || isAdmin();
    }
    match /pathProgress/{id} {
      allow get, list: if signedIn() && (
        resource.data.uid == request.auth.uid
        || isTeacher()
        || isAdmin()
      );
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'pathId', 'step', 'totalSteps', 'wrong', 'done', 'xp', 'streak', 'lastDay', 'updatedAt']);
      allow delete: if false;
    }

    match /exams/{id} {
      allow get: if signedIn() && (resource.data.published == true || resource.data.teacherId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.published == true || resource.data.teacherId == request.auth.uid || isAdmin());
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if (isTeacher() && resource.data.teacherId == request.auth.uid) || isAdmin();
    }
    match /games/{id} {
      allow get: if signedIn() && (resource.data.published == true || resource.data.teacherId == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.published == true || resource.data.teacherId == request.auth.uid || isAdmin());
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if (isTeacher() && resource.data.teacherId == request.auth.uid) || isAdmin();
    }

    // النتائج: الطالب يكتب نتيجته فقط، ويقرأها هو أو المعلم صاحب النشاط أو المدير
    match /results/{id} {
      allow get, list: if signedIn() && (
        resource.data.studentUid == request.auth.uid
        || resource.data.teacherId == request.auth.uid
        || isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'refId', 'teacherId', 'studentUid', 'studentEmail', 'title', 'score', 'total', 'durationSec', 'finishedAt']);
      allow update, delete: if false;
    }

    // ===== منصة مستر يوسف: إدارة المحتوى (مالك + مساعدون) =====
    // صلاحيات المساعد: وثيقة staff/{uid} فيها perms {edit, publish}. المالك هو isAdmin().
    function staffPerms() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.perms;
    }
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // المساعدون: المالك فقط ينشئ ويعدل ويحذف؛ المساعد يقرأ وثيقته هو فقط
    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // المحتوى المنشور: يقرأه الجميع (الطلاب بدون حساب)؛ الكتابة للمالك أو مساعد عنده صلاحية نشر
    match /cmsLive/{id} {
      allow read: if true;
      allow write: if isAdmin() || (signedIn() && staffPerms().publish == true);
    }

    // مسودة المحتوى: يقرأها المالك وأي مساعد؛ الكتابة للمالك أو مساعد عنده صلاحية تعديل
    match /cmsDraft/{id} {
      allow get, list: if isAdmin() || isStaff();
      allow write: if isAdmin() || (signedIn() && staffPerms().edit == true);
    }
  }
}
